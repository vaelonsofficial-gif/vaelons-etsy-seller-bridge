import { NextResponse } from "next/server";

import {
  scanRolled13x18,
} from "../../../../lib/etsy-price-manager";

export async function POST(request) {
  try {
    const body =
      await request.json().catch(() => ({}));

    const listingId =
      body?.listingId || null;

    const results =
      await scanRolled13x18(listingId);

    return NextResponse.json({
      ok: true,
      changed: false,
      targetVariation: "Rolled 13x18",
      targetPrice: 89,
      count: results.length,
      results,
    });
  } catch (error) {
    return NextResponse.json(
      {
        ok: false,
        error: error.message,
      },
      {
        status: 500,
      }
    );
  }
}


