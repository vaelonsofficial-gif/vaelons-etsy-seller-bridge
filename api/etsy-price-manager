import { NextResponse } from "next/server";

import {
  updateRolled13x18,
} from "../../../../lib/etsy-price-manager";

export async function POST(request) {
  try {
    const body = await request.json();

    if (body.approval !== "ONAYLIYORUM") {
      return NextResponse.json(
        {
          ok: false,
          error:
            "Gerçek Etsy değişikliği için approval alanı ONAYLIYORUM olmalıdır.",
        },
        {
          status: 400,
        }
      );
    }

    const listingIds =
      body.listingIds || [];

    const results =
      await updateRolled13x18(
        listingIds
      );

    return NextResponse.json({
      ok: true,
      targetVariation: "Rolled 13x18",
      targetPrice: 89,
      results,
    });
  } catch (error) {
    return NextResponse.json(
      {
        ok: false,
        error: error.message,
      },
      {
        status: 500,
      }
    );
  }
}


